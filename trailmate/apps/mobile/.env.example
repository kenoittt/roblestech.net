# Public configuration only. Everything here ships inside the app bundle — never put a
# Stripe secret key, a Supabase service-role key, or a Mapbox download token in this file.

# `supabase status` locally, or Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe → Developers → API keys (publishable, pk_test_… while testing)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox → Account → Access tokens (public token, pk.…)
EXPO_PUBLIC_MAPBOX_PUBLIC_TOKEN=

# Optional observability (NFR-7)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# --- Build-time only, set as EAS secrets rather than in this file ---
# MAPBOX_DOWNLOAD_TOKEN=sk....
# EAS_PROJECT_ID=
# SENTRY_ORG=
# SENTRY_PROJECT=
