---
import BaseLayout from './BaseLayout.astro';
import '../styles/service-tokens.css';
import '../styles/services.css';

/*
 * Shell for the six service-line pages.
 *
 * Carries what every line page shares — the mesh hero with the brand pattern,
 * the breadcrumb back to the hub, the closing CTA band, and the FAQPage
 * JSON-LD — so a page file holds only its own sections. The nav and footer
 * come from BaseLayout unchanged.
 */
export interface Faq { q: string; a: string }

interface Props {
  title: string;
  description: string;
  /** Small label above the H1, e.g. "Service Line 01 · Flagship". */
  eyebrow: string;
  /** Second, quieter eyebrow under the H1 (Smartsheet uses one). */
  subEyebrow?: string;
  h1: string;
  intro: string;
  /** Breadcrumb leaf, e.g. "GEO + SEO". */
  crumb: string;
  /** Primary hero CTA. */
  ctaLabel: string;
  ctaHref: string;
  /** Optional second hero CTA, rendered as the glass variant. */
  cta2Label?: string;
  cta2Href?: string;
  /** Closing band. */
  closingH2: string;
  closingText: string;
  closingCtaLabel: string;
  closingCtaHref: string;
  /* 'action' (blue) for everything except the two free/credited offers, which
     the design gives the lime accent. */
  closingCtaVariant?: 'action' | 'lime';
  /** Rendered as accordions and emitted as FAQPage schema. */
  faqs?: Faq[];
}

const {
  title, description, eyebrow, subEyebrow, h1, intro, crumb,
  ctaLabel, ctaHref, cta2Label, cta2Href,
  closingH2, closingText, closingCtaLabel, closingCtaHref,
  closingCtaVariant = 'action',
  faqs = [],
} = Astro.props;

// FAQPage schema. Emitted only when the page actually shows the questions, so
// the markup and the structured data can never disagree.
const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---

<BaseLayout title={title} description={description} active="services">
  <Fragment slot="head">
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    <slot name="head" />
  </Fragment>

  <!-- HERO -->
  <div class="page-hero rtcs-mesh">
    <div class="breadcrumb rv">
      <a href="/">Home</a><span>/</span><a href="/services">Services</a><span>/</span>{crumb}
    </div>
    <span class="sec-tag rv d1">{eyebrow}</span>
    <h1 class="sec-h rv d2" set:html={h1} />
    {subEyebrow && (
      <div class="rv d2" style="font-family:'League Spartan',system-ui,sans-serif;font-weight:600;text-transform:uppercase;font-size:11.5px;letter-spacing:.16em;color:var(--rtc-green-400);margin:-6px 0 14px;">
        {subEyebrow}
      </div>
    )}
    <p class="sec-p rv d3">{intro}</p>
    <div class="rtcs-cta-row rv d3" style="margin-top:30px;">
      <a href={ctaHref} class="rtcs-btn-action">{ctaLabel}</a>
      {cta2Label && cta2Href && <a href={cta2Href} class="rtcs-btn-glass">{cta2Label}</a>}
    </div>
  </div>

  <slot />

  {faqs.length > 0 && (
    <section class="rtcs-band rtcs-band-page">
      <div class="rtcs-wrap">
        <div class="rtcs-center" style="margin-bottom:26px;">
          <div class="rtcs-eyebrow">Questions</div>
          <h2 class="rtcs-h2">Frequently Asked</h2>
        </div>
        <div class="rtcs-faq rv">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <div class="a"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CLOSING CTA -->
  <section class="rtcs-band rtcs-mesh">
    <div class="rtcs-wrap rtcs-center">
      <h2 class="rtcs-h2" style="color:#fff;">{closingH2}</h2>
      <p class="rtcs-lead" style="color:rgba(255,255,255,.78);">{closingText}</p>
      <div class="rtcs-cta-row" style="justify-content:center;">
        <a href={closingCtaHref} class={closingCtaVariant === 'lime' ? 'rtcs-btn-lime' : 'rtcs-btn-action'}>{closingCtaLabel}</a>
        <a href="/services" class="rtcs-btn-glass">See All Service Lines</a>
      </div>
    </div>
  </section>
</BaseLayout>
