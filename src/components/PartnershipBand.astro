---
/*
 * "Official partner" band — RTC × Quecko. Homepage, directly after the services
 * grid. Built from the 4b design reference.
 *
 * Asset note: the reference calls for three white PNGs.
 *
 * rtc-logo-white.png is generated by trimming the site's logo_white.png. That
 * file is pure white on transparent, but its mark occupies only 42% of the
 * width and 57% of the height of a 3000x3000 canvas, off-centre — so rendering
 * it at height:52px put roughly a 29px mark on screen and read as missing.
 * public/rtc-logo-white.png is the same artwork cropped to its alpha bounding
 * box (116x156, 3KB versus 217KB), so 52px of box is 52px of logo.
 *
 * quecko-mark-white.png is the delivered Quecko mark, converted the same way.
 * The supplied artwork was black on an opaque white field, so luminance was
 * mapped to alpha — black becomes opaque, the white field becomes clear, and
 * every antialiased edge pixel keeps its exact softness — and the result
 * repainted white for this navy band. It was also trimmed to the mark: the
 * source carried a stray grey artifact in its last column, eleven blank
 * columns clear of the artwork, so the crop takes the largest run of inked
 * columns rather than the outermost inked pixel. 170x198, filling its canvas
 * on both axes.
 *
 * The full Quecko lockup file (quecko-white.png) has still not been delivered,
 * so the wordmark beside the mark is typeset, mirroring how the RTC half pairs
 * its mark with ROBLESTECH.
 *
 * Quecko lime (#D2FF3B) is the one borrowed accent and appears only on the
 * eyebrow and the divider, per the brief.
 */
const CHIPS = [
  'Layer 1 & Layer 2 Development',
  'NFT Marketplaces',
  'Smart Contract Development',
  'RWA Tokenization',
  'DeFi Platforms',
  'Prediction & Opinion Markets',
  'Crypto Exchanges (CEX & DEX)',
  'Coin & Token Development',
  'Crypto Wallet Development',
  'Web3 Enterprise Solutions',
  'Launchpads & Token Sales',
  'Crypto Banking & Financial Rails',
];
---

<section class="pb">
  <div class="pb-mesh" aria-hidden="true"></div>
  <div class="pb-inner">
    <div class="pb-eyebrow rv">Official partner</div>

    <div class="pb-lockup rv d1">
      <span class="pb-rtc">
        <img src="/rtc-logo-white.png" alt="Robles Technologies Corp." class="pb-rtc-mark" width="39" height="52" loading="lazy" decoding="async" />
        <span class="pb-rtc-word">ROBLESTECH</span>
      </span>
      <span class="pb-x" aria-hidden="true">×</span>
      <span class="pb-quecko">
        <img src="/quecko-mark-white.png" alt="Quecko" class="pb-quecko-mark" width="45" height="52" loading="lazy" decoding="async" />
        <span class="pb-quecko-word">QUECKO</span>
      </span>
    </div>

    <div class="pb-divider rv d2" aria-hidden="true"></div>
    <p class="pb-lede rv d2">We bring Web3 services in partnership with Quecko.</p>

    <div class="pb-chips rv d3">
      {CHIPS.map((c) => <span class="pb-chip">{c}</span>)}
    </div>
  </div>
</section>

<style>
  .pb {
    --quecko-lime: #d2ff3b;
    background: var(--rtc-navy-900);
    position: relative;
    overflow: hidden;
  }
  .pb-mesh { position: absolute; inset: 0; background: var(--rtc-gradient-mesh); opacity: .5; }
  .pb-inner { position: relative; max-width: 1200px; margin: 0 auto; padding: 64px 32px; text-align: center; }

  .pb-eyebrow {
    font-family: 'League Spartan', system-ui, sans-serif;
    font-weight: 600; font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--quecko-lime); margin-bottom: 28px;
  }

  .pb-lockup { display: flex; align-items: center; justify-content: center; gap: 36px; margin-bottom: 26px; flex-wrap: wrap; }
  .pb-rtc { display: flex; align-items: center; gap: 12px; }
  .pb-rtc-mark { height: 52px; width: auto; display: block; }
  .pb-rtc-word { font-weight: 800; font-size: 24px; letter-spacing: .02em; color: #fff; }
  .pb-x { font-weight: 300; font-size: 30px; color: rgba(255,255,255,.4); }
  /* Mirrors .pb-rtc: mark plus wordmark, at the same mark height so the two
     halves of the lockup sit on one optical line. */
  .pb-quecko { display: flex; align-items: center; gap: 12px; }
  .pb-quecko-mark { height: 52px; width: auto; display: block; }
  .pb-quecko-word { font-weight: 800; font-size: 24px; letter-spacing: .04em; color: #fff; }

  .pb-divider { width: 56px; height: 2px; background: var(--quecko-lime); margin: 0 auto 22px; opacity: .8; }
  .pb-lede { font-size: 16px; line-height: 1.65; color: rgba(255,255,255,.78); max-width: 560px; margin: 0 auto 30px; }

  .pb-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; max-width: 860px; margin: 0 auto; }
  .pb-chip {
    font-family: 'League Spartan', system-ui, sans-serif;
    font-weight: 600; font-size: 11px; letter-spacing: .08em; text-transform: uppercase;
    color: rgba(255,255,255,.85);
    background: var(--rtc-glass-bg-dark);
    backdrop-filter: blur(var(--rtc-glass-blur));
    -webkit-backdrop-filter: blur(var(--rtc-glass-blur));
    border: 1px solid var(--rtc-glass-border-dark);
    border-radius: 999px; padding: 8px 16px; white-space: nowrap;
  }

  @media (max-width: 700px) {
    .pb-inner { padding: 52px 20px; }
    .pb-lockup { gap: 20px; }
    /* Logo heights scale down ~25% on mobile, per the brief. */
    .pb-rtc-mark { height: 39px; }
    .pb-rtc-word { font-size: 20px; }
    .pb-quecko-mark { height: 39px; }
    .pb-quecko-word { font-size: 20px; }
    .pb-x { font-size: 24px; }
    .pb-chip { font-size: 10px; padding: 7px 13px; }
  }
</style>
