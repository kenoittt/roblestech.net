---
// Site navigation — shared across all pages.
// `active` highlights the current page's link; `contactSolid` gives the
// Contact page its darker CTA treatment (matches the old per-page override).
import StarBorder from './StarBorder.jsx';

interface Props {
  active?: string;
  contactSolid?: boolean;
  /** Inner pages carry the `nav-inner` class (home does not). */
  inner?: boolean;
}
const { active = '', contactSolid = false, inner = false } = Astro.props;

/* The header CTA is a StarBorder. No client:* directive — the component has no
   hooks or effects and the sweep is pure CSS keyframes, so Astro renders it to
   static HTML and this nav still ships zero JavaScript on all twenty pages.
   The same fill is passed twice — once for the button surface and once, via
   `style`, for the ring behind it — which is what makes the ring seamless
   instead of a visible outline. Navy on the Contact page, which is what
   contactSolid has always meant. */
const ctaFill = contactSolid
  ? 'var(--navy)'
  : 'linear-gradient(105deg,#0464DD 0%,#3992FF 50%,#0464DD 100%)';
const isActive = (name: string) =>
  active === name ? 'color:var(--core-blue)' : undefined;
---

<nav id="nav" class:list={['glass-nav', 'rounded-4', 'shadow-lg', 'border', { 'nav-inner': inner }]}>
  <a href="/" class="nav-brand">
    <div class="nav-logo-img">
      <img src="/logo.png" alt="Robles Technologies Corp. logo" onerror="this.style.display='none';this.parentElement.textContent='Logo'" />
    </div>
    <span class="nav-name">Robles <span>Tech</span></span>
  </a>
  <ul class="nav-links">
    <li><a href="/" style={isActive('home')}>Home</a></li>
    <li><a href="/team" style={isActive('team')}>Team</a></li>
    <li><a href="/philosophy" style={isActive('philosophy')}>Philosophy</a></li>
    <li><a href="/services" style={isActive('services')}>Services</a></li>
    <li class="nav-learn">
      <button class="nav-learn-btn">Learn <span class="nav-arrow">▾</span></button>
      <div class="nav-dropdown">
        <a href="/blogs">Blog</a>
        <a href="/faqs">FAQs</a>
      </div>
    </li>
    <li>
      <StarBorder
        as="a"
        href="/contact"
        className={`rtc-star nav-cta-star${contactSolid ? ' nav-cta-star--solid' : ''}`}
        color="#ffffff"
        speed="6s"
        thickness={4}
        backgroundColor={ctaFill}
        textColor="#ffffff"
        borderColor="transparent"
      >Contact Us</StarBorder>
    </li>
  </ul>
  <button class="nav-burger" id="burger" aria-label="Toggle menu">
    <span></span><span></span><span></span>
  </button>
</nav>

{/* Mobile menu, in the shape of React Bits' CardNav: the flat list of links
    became grouped cards, each with a label and its links under an arrow icon.

    Built in markup and CSS rather than by importing the component. This nav is
    in BaseLayout, so it renders on all twenty pages; hydrating CardNav would
    put React and GSAP on every one of them, roughly 280 KB, for a menu that
    only exists below 900px. The same reasoning kept StarBorder unhydrated. The
    card layout is plain flexbox, the height reveal is a CSS transition and the
    stagger is three transition delays, so this still ships no framework.

    The one deliberate departure from CardNav: its mobile breakpoint hides the
    CTA button outright. Contact is this site's primary conversion path, so it
    stays, as a full-width button under the cards. */}
<div class="mobile-menu glass-menu rounded-4 shadow-lg border" id="mobile-menu">
  <div class="mnav-cards">
    <div class="mnav-card" style="--mnav-card-bg:var(--navy)">
      <div class="mnav-card-label">Company</div>
      <div class="mnav-card-links">
        <a href="/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>Home</a>
        <a href="/team"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>Team</a>
        <a href="/philosophy"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>Philosophy</a>
      </div>
    </div>

    <div class="mnav-card" style="--mnav-card-bg:var(--core-blue)">
      <div class="mnav-card-label">Services</div>
      <div class="mnav-card-links">
        <a href="/services"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>All Services</a>
        <a href="/services/geo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>GEO + SEO</a>
        <a href="/services/smartsheet"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>Smartsheet</a>
      </div>
    </div>

    <div class="mnav-card" style="--mnav-card-bg:var(--steel)">
      <div class="mnav-card-label">Learn</div>
      <div class="mnav-card-links">
        <a href="/blogs"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>Blog</a>
        <a href="/faqs"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>FAQs</a>
      </div>
    </div>
  </div>

  <a href="/contact" class="mob-cta">Contact Us</a>
</div>
