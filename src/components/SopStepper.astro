---
/*
 * Horizontal SOP stepper.
 *
 * Nodes are joined by hairline connectors that shrink before the steps do, so
 * a ten-step row stays on one line down to tablet width and wraps into a grid
 * below it. Icons are inline Lucide-style paths using currentColor, which is
 * what lets the hover state recolour them along with the node.
 */
interface Step { label: string; icon: string }
interface Props {
  eyebrow: string;
  steps: Step[];
}
const { eyebrow, steps } = Astro.props;

// Lucide 24-grid line paths, 2px round stroke.
const ICONS: Record<string, string> = {
  brief: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6"/><path d="M9 17h3"/>',
  map: '<path d="M14.1 4.1 20 2v16l-5.9 2.1"/><path d="M14.1 4.1 8 2 2 4.1V20l6-2.1 6.1 2.1"/><path d="M8 2v16"/><path d="M14 4v16"/>',
  list: '<path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/>',
  pen: '<path d="M17 3a2.8 2.8 0 0 1 4 4L7.5 20.5 2 22l1.5-5.5z"/><path d="m15 5 4 4"/>',
  quote: '<path d="M10 11H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2z"/><path d="M10 11c0 4-2 5-4 6"/><path d="M20 11h-4a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2z"/><path d="M20 11c0 4-2 5-4 6"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>',
  clipboard: '<rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="m9 14 2 2 4-4"/>',
  eye: '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7"/><circle cx="12" cy="12" r="3"/>',
  send: '<path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/>',
  search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="m8.5 11 2 2 4-4"/>',
  share: '<circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4"/><path d="m15.4 6.5-6.8 4"/>',
  refresh: '<path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 3v6h-6"/>',
  check: '<circle cx="12" cy="12" r="10"/><path d="m8.5 12.5 2.5 2.5 5-5"/>',
  bot: '<rect width="18" height="12" x="3" y="8" rx="2"/><path d="M12 8V5"/><circle cx="12" cy="4" r="1"/><path d="M8.5 13v2"/><path d="M15.5 13v2"/>',
  dashboard: '<rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/>',
};
---

<div class="rv">
  <div class="svc-eyebrow">{eyebrow}</div>
  <div class="svc-stepper">
    {steps.map((s, i) => (
      <>
        {i > 0 && <div class="conn" aria-hidden="true"></div>}
        <div class="step">
          <div class="svc-node">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[s.icon] ?? ICONS.check} />
          </div>
          <div class="svc-stepn">Step {i + 1}</div>
          <div class="svc-steplabel">{s.label}</div>
        </div>
      </>
    ))}
  </div>
</div>
