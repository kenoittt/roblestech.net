---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact Us — Robles Technologies Corp."
  description="Get in touch with Robles Technologies Corp. Send us a message or book a free 30-minute discovery call. Fixed-price proposals within 48 hours."
  active="contact"
  contactSolid={true}
  scheduleHref="#schedule"
>
  <Fragment slot="head">
    <style>
      /* Salesforce Web-to-Lead form, styled to the RTC design system:
         hairline fields at radius 14, League Spartan labels, 48px action-blue
         submit with the #0356BD hover from the partnership handoff. */
      .sf-form { display: flex; flex-direction: column; gap: 16px; margin-top: 20px; }
      .sf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .sf-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
      .sf-field label {
        font-family: 'League Spartan', system-ui, sans-serif;
        font-weight: 600; font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
        color: #5d6481;
      }
      .sf-req { color: #0464DD; }
      .sf-field input,
      .sf-field textarea {
        font-family: 'Montserrat', system-ui, sans-serif;
        font-size: 0.88rem; color: #1a2338;
        background: #fff; border: 1px solid #e5e5e5; border-radius: 14px;
        padding: 12px 15px; width: 100%; outline: none;
        transition: border-color 200ms cubic-bezier(.4,0,.2,1), box-shadow 200ms cubic-bezier(.4,0,.2,1);
      }
      .sf-field textarea { resize: vertical; line-height: 1.65; }
      .sf-field input::placeholder,
      .sf-field textarea::placeholder { color: #9aa3b8; }
      .sf-field input:focus,
      .sf-field textarea:focus { border-color: #0464DD; box-shadow: 0 0 0 3px rgba(57,146,255,.28); }
      .sf-field input:invalid:not(:placeholder-shown) { border-color: #d2544a; }

      .sf-submit {
        display: inline-flex; align-items: center; justify-content: center;
        height: 48px; padding: 0 26px; border: none; border-radius: 14px;
        background: #0464DD; color: #fff; cursor: pointer;
        font-family: 'Montserrat', system-ui, sans-serif; font-weight: 700; font-size: 15px;
        transition: background 200ms cubic-bezier(.4,0,.2,1), transform 200ms cubic-bezier(.4,0,.2,1);
      }
      .sf-submit:hover { background: #0356bd; }
      .sf-submit:active { transform: translateY(1px); }
      .sf-submit:focus-visible { outline: none; box-shadow: 0 0 0 3px rgba(57,146,255,.45); }

      .sf-note { font-size: 0.74rem; color: #5d6481; line-height: 1.6; margin: 2px 0 0; }

      @media (max-width: 620px) {
        .sf-row { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) {
        .sf-field input, .sf-field textarea, .sf-submit { transition: none; }
        .sf-submit:active { transform: none; }
      }
    </style>
  </Fragment>

  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-pat"></div>
    <div class="breadcrumb rv"><a href="/">Home</a><span>/</span>Contact Us</div>
    <span class="sec-tag rv d1">Get In Touch</span>
    <h1 class="sec-h rv d2">Let's talk about<br>your project.</h1>
    <p class="sec-p rv d3">Have questions or want to reach us without scheduling a call? Send us a message below. Ready to move forward? Book a time directly on our calendar.</p>
  </div>

  <!-- CONTACT INFO CARDS -->
  <section class="sec" style="background:var(--off-white);padding-bottom:0;">
    <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:18px;" class="rv">
      <div class="contact-detail rv rtc-lift">
        <div class="cd-icon"></div>
        <div>
          <div class="cd-label">Email</div>
          <div class="cd-val"><a href="mailto:contact@roblestech.net">contact@roblestech.net</a><br>We respond within 1 business day</div>
        </div>
      </div>
      <div class="contact-detail rv rtc-lift d1">
        <div class="cd-icon"></div>
        <div>
          <div class="cd-label">Proposal Turnaround</div>
          <div class="cd-val">Fixed-price proposals delivered within <strong>48 hours</strong> of your discovery call</div>
        </div>
      </div>
      <div class="contact-detail rv rtc-lift d2">
        <div class="cd-icon"></div>
        <div>
          <div class="cd-label">Based In</div>
          <div class="cd-val">Philippines · Global delivery<br>We work across time zones seamlessly</div>
        </div>
      </div>
      <div class="contact-detail rv rtc-lift d3">
        <div class="cd-icon"></div>
        <div>
          <div class="cd-label">Smartsheet Pricing</div>
          <div class="cd-val">Launchpad $3,500 · Momentum $9,500 · Enterprise $22,000<br><a href="/services#smartsheet">See all tiers →</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- MAIN CONTACT SECTION -->
  <section class="sec" style="background:var(--off-white);" id="contact-main">
    <div class="contact-two-col">

      <!-- SALESFORCE WEB-TO-LEAD FORM -->
      <div class="embed-card rv">
        <h2>Send Us a Message</h2>
        <p>For inquiries, questions, or if you'd like to reach us without scheduling a meeting — fill out the form below and we'll get back to you within 1 business day.</p>

        <form class="sf-form" action="https://webto.salesforce.com/servlet/servlet.WebToLead?encoding=UTF-8&orgId=00Dd500000JnGbl" method="POST">
          <input type="hidden" name="oid" value="00Dd500000JnGbl" />
          {/* Salesforce redirects here after the POST — the thank-you page then
              returns the visitor to the homepage. */}
          <input type="hidden" name="retURL" value="https://roblestech.net/thank-you" />
          <input type="hidden" id="lead_source" name="lead_source" value="Web" />

          <div class="sf-row">
            <div class="sf-field">
              <label for="first_name">First name</label>
              <input id="first_name" name="first_name" maxlength="40" type="text" autocomplete="given-name" />
            </div>
            <div class="sf-field">
              <label for="last_name">Last name <span class="sf-req">*</span></label>
              <input id="last_name" name="last_name" maxlength="80" type="text" required autocomplete="family-name" />
            </div>
          </div>

          <div class="sf-row">
            <div class="sf-field">
              <label for="email">Email <span class="sf-req">*</span></label>
              <input id="email" name="email" maxlength="80" type="email" required autocomplete="email" />
            </div>
            <div class="sf-field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" maxlength="40" type="tel" autocomplete="tel" />
            </div>
          </div>

          {/* Company is required by Salesforce to create a Lead — a submission
              without it is rejected, so it is required here too. */}
          <div class="sf-field">
            <label for="company">Company <span class="sf-req">*</span></label>
            <input id="company" name="company" maxlength="40" type="text" required autocomplete="organization" />
          </div>

          <div class="sf-field">
            <label for="description">How can we help?</label>
            <textarea id="description" name="description" rows="5" placeholder="Tell us about your project, timeline, and what you're trying to solve."></textarea>
          </div>

          <button type="submit" name="submit" class="sf-submit">Send Message →</button>
          <p class="sf-note">We reply within 1 business day. Your details go straight to our team — we never share or sell them.</p>
        </form>
      </div>

      <!-- SCHEDULE + INFO -->
      <div class="contact-info-col rv d1" id="schedule">

        <!-- CALENDLY CARD -->
        <div class="calendly-cta-card">
          <h3>Schedule a Call</h3>
          <p>Book a free 30-minute discovery call directly on our calendar. No back-and-forth — just pick a time that works for you.</p>
          <ul class="calendly-perks">
            <li>Free 30-minute discovery call</li>
            <li>Speak directly with Kenneth Robles</li>
            <li>Walk away with a clear scope and next steps</li>
            <li>Fixed-price proposal delivered within 48 hours</li>
          </ul>
          <a href="" onclick="Calendly.initPopupWidget({url:'https://calendly.com/kenneth-roblestech/30min'});return false;" class="btn btn-white">Book a Call →</a>
        </div>

        <!-- WHAT HAPPENS NEXT -->
        <div class="contact-promise">
          <h4>What happens after you reach out</h4>
          <ul>
            <li>We review your message and confirm receipt same day</li>
            <li>We schedule a free 30-minute discovery call at your convenience</li>
            <li>We scope your project and send a fixed-price proposal within 48 hours</li>
            <li>You review, ask questions, approve — and we get to work</li>
          </ul>
        </div>

        <!-- SERVICES QUICK LINKS -->
        <div style="background:var(--white);border-radius:14px;padding:22px 24px;border:1.5px solid rgba(3,44,124,.07);">
          <div class="cd-label" style="margin-bottom:14px;">Explore Our Service Lines</div>
          <div style="display:flex;flex-direction:column;gap:9px;">
            <a href="/services#seo" style="font-size:var(--fs-xs);color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:8px;font-weight:600;">
              <span></span> Generative Engine Optimization (GEO) <span style="color:var(--core-blue);margin-left:auto;">→</span>
            </a>
            <a href="/services#consulting" style="font-size:var(--fs-xs);color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:8px;font-weight:600;">
              <span></span> Technical Consulting Services <span style="color:var(--core-blue);margin-left:auto;">→</span>
            </a>
            <a href="/services#smartsheet" style="font-size:var(--fs-xs);color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:8px;font-weight:600;">
              <span></span> Smartsheet Development Services <span style="color:var(--core-blue);margin-left:auto;">→</span>
            </a>
            <a href="/services#automation" style="font-size:var(--fs-xs);color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:8px;font-weight:600;">
              <span></span> Automation Services <span style="color:var(--core-blue);margin-left:auto;">→</span>
            </a>
            <a href="/services#web3" style="font-size:var(--fs-xs);color:var(--navy);text-decoration:none;display:flex;align-items:center;gap:8px;font-weight:600;">
              <span></span> Web3 Services <span style="color:var(--core-blue);margin-left:auto;">→</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA FOOTER STRIP -->
  <div class="strip rv rtc-sheen" style="margin-top:0;">
    <div>
      <h3>Prefer a quick chat over a form?</h3>
      <p>Skip the inbox — book a 30-minute call and get answers immediately.</p>
    </div>
    <a href="" onclick="Calendly.initPopupWidget({url:'https://calendly.com/kenneth-roblestech/30min'});return false;" class="btn btn-white">Book a Call →</a>
  </div>
</BaseLayout>
