---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/service-tokens.css';
import '../styles/services.css';

/*
 * Services hub.
 *
 * Replaces the old single anchored /services page: this is now a slim hub of
 * six cards, and every tier table lives on its own service-line page. Copy and
 * layout follow the Services wireframe handoff.
 */
const CAL = "Calendly.initPopupWidget({url:'https://calendly.com/kenneth-roblestech/30min'});return false;";

const LINES = [
  {
    eyebrow: 'Service Line 01 · Flagship',
    name: 'GEO + SEO',
    href: '/services/geo',
    flag: 'svc-card-flag',
    body: 'When your customers ask ChatGPT, Gemini or Perplexity which brand to buy, we make sure you are the answer. Citation-optimized content, structured data and technical SEO built for the AI-search era, with a live dashboard showing every citation gained.',
    price: 'Start with a free AI Visibility Gap Report. Monthly programs from $2,500.',
    cta: 'Explore GEO + SEO',
  },
  {
    eyebrow: 'Service Line 02 · Founding Practice',
    name: 'Smartsheet Consulting',
    href: '/services/smartsheet',
    flag: 'svc-card-flag svc-card-flag-navy',
    body: 'Your process, rebuilt as a working operations engine. Sheets, automations, dashboards and integrations designed by certified Smartsheet consultants who have shipped this for Fortune 500 operations teams.',
    price: 'Fixed-price projects from $3,500, live in 2 to 3 weeks.',
    cta: 'Explore Smartsheet',
  },
  {
    eyebrow: 'Service Line 03',
    name: 'Automations & AI',
    href: '/services/ai-automation',
    flag: '',
    body: 'Custom AI agents and event-driven pipelines that remove the manual handoffs between your tools. Built for your workflow, not pulled off a shelf.',
    price: 'Start with the $2,500 Automation Audit, credited in full toward any build within 60 days.',
    cta: 'Explore Automations & AI',
  },
  {
    eyebrow: 'Service Line 04 · With Quecko',
    name: 'Web3 & Blockchain',
    href: '/services/web3',
    flag: '',
    body: 'Smart contracts, wallets, tokenization and exchanges, delivered with our partner Quecko. Plus a straight answer on where blockchain adds value to your business and where it does not.',
    price: 'Scoped per project after a discovery call.',
    cta: 'Explore Web3',
  },
  {
    eyebrow: 'Service Line 05',
    name: 'Web Development & UI',
    href: '/services/web-development',
    flag: '',
    body: 'Fast, accessible front-ends for marketing sites, client portals, internal tools and customer-facing products. Built for real users and engineered to grow with you.',
    price: 'Scoped per project after a discovery call.',
    cta: 'Explore Web Development',
  },
  {
    eyebrow: 'Service Line 06',
    name: 'Technical Consulting',
    href: '/services/technical-consulting',
    flag: '',
    body: 'Architecture reviews, integrations and platform strategy, from a single advisory session to an embedded technical lead who acts as your CTO.',
    price: 'Advisory from $200/hr. Retainers from $3,500/mo.',
    cta: 'Explore Technical Consulting',
  },
];

const HOW = [
  { n: '01', h: 'Discovery', p: 'We listen first. Understanding your workflows, goals and bottlenecks before proposing anything.' },
  { n: '02', h: 'Solution Design', p: 'We map the right technical approach, scoped, documented and aligned to your business outcomes.' },
  { n: '03', h: 'Build & Deliver', p: 'Execution with consistent communication. You stay informed at every stage, no surprises at launch.' },
  { n: '04', h: 'Support & Scale', p: 'We stay after launch. Ongoing support and iteration so solutions scale as your business grows.' },
];
---

<BaseLayout
  title="Services — Robles Technologies Corp."
  description="Six service lines, one embedded team. GEO + SEO, Smartsheet consulting, automations and AI, Web3, web development and technical consulting — scoped, priced and delivered with a fixed-price proposal within 48 hours."
  active="services"
>
  <!-- HERO -->
  <div class="page-hero svc-mesh">
    <div class="breadcrumb rv"><a href="/">Home</a><span>/</span>Services</div>
    <span class="sec-tag rv d1">What We Do</span>
    <h1 class="sec-h rv d2">Six Service Lines.<br>One Embedded Team.</h1>
    <p class="sec-p rv d3">Every engagement is tied to a business result you can measure: citations gained, hours removed, systems connected. Pick the line that matches your problem. We scope it, price it and deliver it with a fixed-price proposal within 48 hours.</p>
    <div class="svc-cta-row rv d3" style="margin-top:28px;justify-content:center;">
      <a href="" onclick={CAL} class="svc-btn-lime">Book a Free Discovery Call</a>
    </div>
  </div>

  <!-- SIX SERVICE LINES -->
  <section class="svc-band svc-band-page">
    <div class="svc-wrap">
      <div class="svc-grid">
        {LINES.map((l) => (
          <a href={l.href} class={`svc-card svc-card-link ${l.flag}`} style="text-decoration:none;">
            <div class="svc-eyebrow">{l.eyebrow}</div>
            <h3>{l.name}</h3>
            <p>{l.body}</p>
            <div class="svc-price-line">{l.price}</div>
            <span class="svc-explore">{l.cta} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CROSS-SELL -->
  <section class="svc-band svc-band-sunken">
    <div class="svc-wrap svc-center">
      <h2 class="svc-h2">Need More Than One Line?</h2>
      <p class="svc-lead">Most clients start with one problem and find the next one behind it. A GEO client needs a faster site. A Smartsheet client needs an integration. We build the engagement around what you actually need, so you work with one embedded partner instead of five vendors.</p>
      <a href="" onclick={CAL} class="svc-btn-outline">Book a Call to Scope It →</a>
    </div>
  </section>

  <!-- HOW WE WORK -->
  <section class="svc-band svc-band-page">
    <div class="svc-wrap">
      <div class="svc-center" style="margin-bottom:30px;">
        <div class="svc-eyebrow">How We Work</div>
        <h2 class="svc-h2">Structured Delivery From Day One</h2>
      </div>
      <div class="svc-grid-4 rv">
        {HOW.map((s) => (
          <div class="svc-step-card">
            <div class="n">{s.n}</div>
            <h4>{s.h}</h4>
            <p>{s.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="svc-band svc-mesh">
    <div class="svc-wrap svc-center">
      <div class="svc-eyebrow svc-eyebrow-green">Start Building With RTC</div>
      <h2 class="svc-h2" style="color:#fff;">Ready to Discuss Your Project?</h2>
      <p class="svc-lead" style="color:rgba(255,255,255,.78);">Every engagement starts with a free 30-minute discovery call. Tell us the problem, and we will send a fixed-price proposal within 48 hours. No commitment required.</p>
      <div class="svc-cta-row" style="justify-content:center;">
        <a href="" onclick={CAL} class="svc-btn-lime">Book a Discovery Call →</a>
        <a href="/contact" class="svc-btn-glass">Send a Message</a>
      </div>
    </div>
  </section>
</BaseLayout>
