---
import { avatarSrc, initials, tint } from '../lib/avatar';

interface Props {
  id: string;
  name?: string | null;
  email?: string | null;
  path?: string | null;
  size?: number;
}
const { id, name, email, path, size = 26 } = Astro.props;
const src = avatarSrc(id, path);
// alt="" on purpose: the person's name is always rendered next to the avatar,
// so a screen reader would otherwise announce it twice.
---
{src ? (
  <img class="avatar" src={src} alt="" width={size} height={size} loading="lazy"
       style={`width:${size}px;height:${size}px;`} />
) : (
  <span class="avatar avatar-i" aria-hidden="true"
        style={`width:${size}px;height:${size}px;background:${tint(id)};font-size:${Math.max(9, Math.round(size * 0.4))}px;`}>
    {initials(name, email)}
  </span>
)}
