---
/*
 * The app nav.
 *
 * Three menus and nothing else: Project Management, Knowledge Base, Account
 * settings. It replaces React Bits' CardNav, which opened into three large
 * coloured cards — that panel was taller than the viewport on a laptop, so the
 * last item in each card was cut off, and it dropped a React island plus GSAP
 * into every page of an internal tool to do the work of a dropdown.
 *
 * This is plain HTML with about thirty lines of script. Nothing hydrates, so
 * the menus work the moment the markup arrives rather than after a bundle
 * loads, and PPM no longer depends on React, react-dom, @astrojs/react or gsap
 * at all.
 */
import Avatar from './Avatar.astro';

interface Link { label: string; href?: string; action?: string; }
interface Props {
  groups: { id: string; label: string; links: Link[] }[];
  account: { id: string; name: string; email: string; avatar: string | null } | null;
  ctaLabel: string;
  ctaHref: string;
  current: string;
}
const { groups, account, ctaLabel, ctaHref, current } = Astro.props;

/** A menu is "current" when the page you are on is one of its destinations. */
const isCurrent = (links: Link[]) =>
  links.some((l) => {
    if (!l.href) return false;
    const path = l.href.split('?')[0].split('#')[0];
    if (path === '/') return current === '/';
    return current === path || current.startsWith(path + '/');
  });
---

<header class="nv">
  <nav class="nv-bar" aria-label="Main">
    <a class="nv-brand" href="/" aria-label="Robles Tech PPM">
      <img src="/logo-white.png" alt="" width="28" height="28" />
    </a>

    <button class="nv-burger" type="button" aria-expanded="false" aria-controls="nv-menus"
            aria-label="Menu" data-nv-burger>
      <span></span><span></span><span></span>
    </button>

    <div class="nv-menus" id="nv-menus" data-nv-menus>
      {groups.map((g) => (
        <div class="nv-group" data-nv-group>
          <button type="button" aria-expanded="false"
                  aria-controls={`nv-panel-${g.id}`}
                  class:list={['nv-top', { 'is-current': isCurrent(g.links) }]}
                  data-nv-toggle>
            {g.label}
            <svg class="nv-chev" width="12" height="12" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="3" stroke-linecap="round"
                 stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>

          <div class="nv-panel" id={`nv-panel-${g.id}`} hidden data-nv-panel>
            {g.id === 'account' && account && (
              <div class="nv-me">
                <Avatar id={account.id} name={account.name} email={account.email}
                        path={account.avatar} size={34} />
                <div class="nv-me-t">
                  <strong>{account.name}</strong>
                  <span>{account.email}</span>
                </div>
              </div>
            )}
            <ul>
              {g.links.map((l) => (
                <li>
                  {l.action ? (
                    <button type="button" data-action-label={l.action}>{l.label}</button>
                  ) : (
                    <a href={l.href} aria-current={l.href === current ? 'page' : undefined}>{l.label}</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    {/* The theme switch lives in the bar, not in the Account menu. It is the
        one control here people flip repeatedly — usually because the room's
        light changed — and burying a two-state control behind a menu costs
        two clicks and a text label that has to describe the state you are NOT
        in. A switch shows both states at once and takes one tap.

        It is driven by the data-theme attribute in CSS rather than by its own
        aria-checked, so it cannot drift out of step with the page: the no-flash
        script in <head> sets the attribute before this ever renders. */}
    <button class="nv-theme" type="button" role="switch" aria-checked="false" data-theme-switch>
      <span class="sr-only" data-theme-label>Dark mode</span>
      <span class="nv-theme-track" aria-hidden="true">
        <svg class="nv-theme-i i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" />
        </svg>
        <svg class="nv-theme-i i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
        </svg>
        <span class="nv-theme-knob"></span>
      </span>
    </button>

    <a class="nv-cta" href={ctaHref}>{ctaLabel}</a>
  </nav>
</header>

<style>
  .nv { position: fixed; top: 16px; left: 0; right: 0; z-index: 100; padding: 0 16px; }
  .nv-bar {
    display: flex; align-items: center; gap: 10px;
    width: 100%; max-width: 1180px; margin: 0 auto;
    height: 64px; padding: 0 12px 0 18px; border-radius: 18px;
    background: var(--s-25);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid var(--s-4); box-shadow: var(--nav-shadow);
  }

  .nv-brand { display: inline-flex; align-items: center; flex: 0 0 auto; }
  .nv-brand img { height: 26px; width: auto; display: block; }
  /* The only logo asset is a white mark, which disappears on the light theme's
     white bar. A navy chip keeps the real mark rather than inverting it into a
     different colour. */
  /* The chip is on the image, not the link, so the link can carry a bigger tap
     area on a phone without the chip growing with it. */
  :global(:root[data-theme='light']) .nv-brand img {
    background: var(--navy); border-radius: 9px; padding: 5px 7px; box-sizing: content-box;
  }

  .nv-menus { display: flex; align-items: center; gap: 4px; margin-left: 10px; }
  .nv-group { position: relative; }

  .nv-top {
    display: inline-flex; align-items: center; gap: 7px;
    font: 700 .9rem/1 'Montserrat', system-ui, sans-serif;
    color: var(--fg-soft); background: transparent; border: 0; cursor: pointer;
    padding: 10px 13px; border-radius: 10px; white-space: nowrap;
  }
  .nv-top:hover { color: var(--fg); background: var(--s-2); }
  .nv-top.is-current { color: var(--fg); }
  .nv-top[aria-expanded='true'] { color: var(--fg); background: var(--s-3); }
  .nv-chev { transition: transform .18s ease; opacity: .65; }
  .nv-top[aria-expanded='true'] .nv-chev { transform: rotate(180deg); }

  .nv-panel {
    position: absolute; top: calc(100% + 10px); left: 0; min-width: 232px;
    background: var(--pop); border: 1px solid var(--line); border-radius: 14px;
    box-shadow: var(--pop-shadow); padding: 8px; z-index: 2;
  }
  .nv-panel[hidden] { display: none; }
  .nv-panel ul { list-style: none; margin: 0; padding: 0; }
  .nv-panel a,
  .nv-panel button {
    display: block; width: 100%; text-align: left;
    font: 600 .88rem/1.2 'Montserrat', system-ui, sans-serif;
    color: var(--fg-soft); text-decoration: none; background: transparent; border: 0;
    cursor: pointer; padding: 10px 12px; border-radius: 9px;
  }
  .nv-panel a:hover, .nv-panel button:hover { background: var(--s-2); color: var(--fg); }
  .nv-panel a[aria-current='page'] { color: var(--accent-fg); background: var(--s-1); }

  .nv-me {
    display: flex; align-items: center; gap: 10px;
    padding: 8px 12px 12px; margin-bottom: 6px; border-bottom: 1px solid var(--line-soft);
  }
  .nv-me-t { display: flex; flex-direction: column; min-width: 0; }
  .nv-me-t strong { font-size: .88rem; color: var(--fg); }
  .nv-me-t span {
    font-size: .76rem; color: var(--muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 190px;
  }

  /* The theme switch. Both states are on show, and the knob sits over the one
     you are currently in. */
  .nv-theme {
    margin-left: auto; flex: 0 0 auto;
    background: transparent; border: 0; padding: 0; cursor: pointer; line-height: 0;
  }
  .nv-theme-track {
    position: relative; display: inline-flex; align-items: center; justify-content: space-between;
    width: 58px; height: 30px; padding: 0 7px; border-radius: 999px;
    background: var(--s-1); border: 1px solid var(--line);
  }
  .nv-theme:hover .nv-theme-track { border-color: var(--s-4); }
  .nv-theme:focus-visible .nv-theme-track { outline: 2px solid var(--accent-fg); outline-offset: 2px; }
  .nv-theme-i { width: 14px; height: 14px; position: relative; z-index: 1; }
  .i-moon { color: var(--fg); }
  .i-sun { color: var(--muted); }
  .nv-theme-knob {
    position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%;
    background: var(--s-3); border: 1px solid var(--line);
    transition: transform .22s cubic-bezier(.4, 0, .2, 1);
  }
  /* Keyed off the page's theme, never off the button's own state. */
  :global(:root[data-theme='light']) .nv-theme-knob { transform: translateX(28px); }
  :global(:root[data-theme='light']) .i-sun { color: var(--fg); }
  :global(:root[data-theme='light']) .i-moon { color: var(--muted); }
  @media (prefers-reduced-motion: reduce) { .nv-theme-knob { transition: none; } }

  .nv-cta {
    flex: 0 0 auto;
    font: 700 .85rem/1 'Montserrat', system-ui, sans-serif;
    color: var(--deep); background: var(--green); text-decoration: none;
    padding: 11px 17px; border-radius: 10px; white-space: nowrap;
  }
  .nv-cta:hover { filter: brightness(1.06); }

  /* The hamburger only exists on narrow screens. */
  .nv-burger { display: none; }

  @media (max-width: 900px) {
    .nv-bar { height: 58px; padding: 0 10px 0 14px; gap: 8px; }
    /* Touch targets. Everything tappable in the bar gets at least 44x44 on a
       phone, which several of these missed — the burger was 40x40, the theme
       switch 58x30, the logo 26x26. The visible shapes are unchanged: the
       extra size is padding around them, which is what "expand the hit area
       when the icon is smaller" means. */
    .nv-burger {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; padding: 0 11px;
      background: transparent; border: 0; cursor: pointer; order: 3;
    }
    .nv-theme { display: inline-flex; align-items: center; min-height: 44px; padding: 0 7px; }
    .nv-cta { min-height: 44px; display: inline-flex; align-items: center; }
    .nv-brand { min-width: 44px; min-height: 44px; justify-content: center; margin-left: -9px; }
    .nv-burger span {
      display: block; height: 2px; width: 100%; border-radius: 2px;
      background: var(--fg); transition: transform .2s ease, opacity .2s ease;
    }
    .nv-burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nv-burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
    .nv-burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    .nv-theme { order: 1; margin-left: auto; }
    .nv-cta { order: 2; margin-left: 0; padding: 9px 14px; font-size: .8rem; }

    /* Stacked, not cards: every group is a heading with its links under it, so
       nothing is hidden behind a second tap and nothing gets clipped. */
    .nv-menus {
      display: none; order: 4; flex-direction: column; align-items: stretch;
      gap: 2px; width: 100%; margin: 0; padding: 6px 4px 10px;
    }
    .nv-menus.is-open { display: flex; }
    .nv-bar { flex-wrap: wrap; height: auto; min-height: 58px; padding-bottom: 0; }
    /* Open, the bar stops being a thin strip over the page and becomes a panel
       covering it. Glass at 6% white is legible as a strip and completely
       illegible as a panel — the dashboard shows straight through the links —
       so an open menu drops the transparency. */
    .nv-bar:has(.nv-menus.is-open) {
      padding-bottom: 6px;
      background: var(--pop);
      backdrop-filter: none; -webkit-backdrop-filter: none;
      box-shadow: var(--pop-shadow);
    }

    .nv-group { position: static; }
    .nv-top { width: 100%; justify-content: space-between; padding: 12px; min-height: 44px; }
    .nv-panel a, .nv-panel button { min-height: 44px; display: flex; align-items: center; }
    .nv-panel {
      position: static; min-width: 0; background: transparent; border: 0;
      box-shadow: none; padding: 0 0 8px 8px;
    }
    .nv-me { padding-left: 4px; }
  }
</style>

<script is:inline>
  (function () {
    var bar = document.querySelector('[data-nv-menus]');
    if (!bar) return;
    var burger = document.querySelector('[data-nv-burger]');

    function panelOf(btn) { return btn.parentElement.querySelector('[data-nv-panel]'); }

    function closeAll(except) {
      document.querySelectorAll('[data-nv-toggle]').forEach(function (b) {
        if (b === except) return;
        b.setAttribute('aria-expanded', 'false');
        panelOf(b).hidden = true;
      });
    }

    document.addEventListener('click', function (e) {
      var toggle = e.target.closest && e.target.closest('[data-nv-toggle]');
      if (toggle) {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        closeAll(toggle);
        toggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        panelOf(toggle).hidden = open;
        return;
      }
      if (e.target.closest && e.target.closest('[data-nv-burger]')) {
        var isOpen = bar.classList.toggle('is-open');
        burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (!isOpen) closeAll(null);
        return;
      }
      // A click anywhere else closes the menus, including inside a panel —
      // following a link should not leave the menu open behind the new page.
      closeAll(null);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      closeAll(null);
      if (bar.classList.contains('is-open')) {
        bar.classList.remove('is-open');
        burger.setAttribute('aria-expanded', 'false');
      }
    });
  })();
</script>
