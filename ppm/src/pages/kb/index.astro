---
/*
 * Handbook hub: a rail of categories beside a grid of article cards.
 *
 * The rail owns the category, so the filter panel no longer offers one — two
 * controls for the same thing is how they end up disagreeing. What is left
 * behind the funnel is status and owner.
 *
 * Search and filtering happen on the server, in the query, rather than in the
 * browser over a preloaded list. The body text is searchable, and shipping
 * every article's full body to the client so it can grep them would get slower
 * with every article written. It also means a filtered view has a real URL,
 * which is shareable and survives a refresh.
 */
import AppLayout from '../../layouts/AppLayout.astro';
import KbCard from '../../components/KbCard.astro';
import { getCategories, searchArticles, getOwners, STATUS_LABEL, snippet } from '../../lib/kb';
import type { KbStatus } from '../../lib/kb';

export const prerender = false;

const profile = Astro.locals.profile;
const isAdmin = profile?.role === 'admin' || profile?.role === 'super_admin';

const url = Astro.url;
const q = url.searchParams.get('q') ?? '';
const category = url.searchParams.get('category') ?? '';
const status = url.searchParams.get('status') ?? '';
const owner = url.searchParams.get('owner') ?? '';

/* Picking a category is navigation, not a search. Only the free text and the
   two panel filters put the page into "results" mode, where the grid stops
   being a shelf and starts being a ranked list. */
const searching = Boolean(q || status || owner);

const [categories, owners, articles] = await Promise.all([
  getCategories(Astro),
  getOwners(Astro),
  searchArticles(Astro, { q, category, status, owner }),
]);

const active = categories.find((c) => c.slug === category) ?? null;

/** Same view, different category — everything else about the query survives. */
const railHref = (slug: string) => {
  const next = new URLSearchParams(url.searchParams);
  if (slug) next.set('category', slug);
  else next.delete('category');
  const s = next.toString();
  return s ? `/kb?${s}` : '/kb';
};

/* The filters are behind an icon, so what is applied has to stay visible or a
   filtered page reads as an empty handbook. Each chip links to the same view
   minus that one filter, which is also how you remove it — no JavaScript. */
const dropParam = (key: string) => {
  const next = new URLSearchParams(url.searchParams);
  next.delete(key);
  const s = next.toString();
  return s ? `/kb?${s}` : '/kb';
};
const chips: { label: string; href: string }[] = [];
if (status) chips.push({ label: STATUS_LABEL[status as KbStatus] ?? status, href: dropParam('status') });
if (owner) chips.push({ label: owner, href: dropParam('owner') });
const filterCount = chips.length;

const byCategory = (id: string) => articles.filter((a) => a.category_id === id);
---

<AppLayout title="Handbook · RTC PPM">
  <p class="eyebrow">Internal</p>
  <h1>Team Handbook</h1>
  <p class="lede">
    How we write, how we run calls, how delivery works, and what every tool is for.
    Nobody outside the team can reach these pages.
  </p>

  <form class="kbf" method="get" action="/kb">
    <div class="kbf-bar">
      <svg class="kbf-icon" width="17" height="17" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
      </svg>
      <label class="sr-only" for="q">Search the handbook</label>
      <input id="q" name="q" type="search" value={q} autocomplete="off"
             placeholder="Search everything — a title, a phrase, a tool name" />
      <button class="btn kbf-go" type="submit">Search</button>
    </div>
  </form>

  <div class="kbh">
    {/* Two different left columns, because they do two different jobs. While
        you are browsing, the shelf you are on is the only thing that matters,
        so it is a plain rail. Once you have searched, the question becomes how
        to narrow a result set, so it is a filter card — collapsible, because
        on a short list the filters are just a column of things you do not
        need. */}
    {searching ? (
      <form class="kbfc" method="get" action="/kb" data-filters>
        {q && <input type="hidden" name="q" value={q} />}
        <div class="kbfc-head">
          <span class="kbfc-title">Filters</span>
          <button class="kbfc-collapse" type="button" aria-expanded="true"
                  aria-controls="kbfc-body" data-filters-toggle>
            <span class="sr-only">Hide filters</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m11 6-6 6 6 6M19 6l-6 6 6 6" />
            </svg>
          </button>
        </div>

        <div class="kbfc-body" id="kbfc-body" data-filters-body>
          <details class="kbfc-grp" open={!!category}>
            <summary>Category<svg width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
            <label class="sr-only" for="f-category">Category</label>
            <select id="f-category" name="category" data-kbf-select>
              <option value="">All categories</option>
              {categories.map((c) => <option value={c.slug} selected={c.slug === category}>{c.title}</option>)}
            </select>
          </details>

          <details class="kbfc-grp" open={!!status}>
            <summary>Status<svg width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
            <label class="sr-only" for="f-status">Status</label>
            <select id="f-status" name="status" data-kbf-select>
              <option value="">Any status</option>
              {(['ready', 'draft', 'needed'] as KbStatus[]).map((s) => (
                <option value={s} selected={s === status}>{STATUS_LABEL[s]}</option>
              ))}
            </select>
          </details>

          <details class="kbfc-grp" open={!!owner}>
            <summary>Owner<svg width="14" height="14" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg></summary>
            <label class="sr-only" for="f-owner">Owner</label>
            <select id="f-owner" name="owner" data-kbf-select>
              <option value="">Any owner</option>
              {owners.map((o) => <option value={o} selected={o === owner}>{o}</option>)}
            </select>
          </details>

          {/* Without JavaScript the selects do nothing on their own, so the
              card keeps its own submit. With it, changing one searches. */}
          <button class="btn kbfc-apply" type="submit">Apply</button>
          {chips.length > 0 && <a class="kbfc-clear" href={q ? `/kb?q=${encodeURIComponent(q)}` : '/kb'}>Clear all</a>}
        </div>
      </form>
    ) : (
      <nav class="kbh-rail" aria-label="Handbook categories">
        <a href={railHref('')} class:list={['kbh-rail-i', { 'is-on': !active }]}
         aria-current={!active ? 'page' : undefined}>All articles</a>
        {categories.map((c) => (
        <a href={railHref(c.slug)} class:list={['kbh-rail-i', { 'is-on': active?.id === c.id }]}
           aria-current={active?.id === c.id ? 'page' : undefined}>{c.title}</a>
      ))}
        {isAdmin && <a class="kbh-rail-admin" href="/admin/kb">Manage the handbook</a>}
      </nav>
    )}

    <div class="kbh-panel">
      {searching ? (
        <>
          <p class="kbh-count">
            {articles.length} {articles.length === 1 ? 'result' : 'results'}
            {q && <> for “{q}”</>}
            {active && <> in {active.title}</>}
          </p>
          {articles.length === 0 ? (
            <p class="kbh-empty">Nothing matches. Try a shorter word, or clear the filters.</p>
          ) : (
            <div class="kbh-grid">
              {articles.map((a) => <KbCard article={a} snippet={q ? snippet(a.body, q) : null} />)}
            </div>
          )}
        </>
      ) : active ? (
        <>
          {active.blurb && <p class="kbh-blurb">{active.blurb}</p>}
          {articles.length === 0 ? (
            <p class="kbh-empty">
              Nothing on this shelf yet. That is a gap we know about rather than one we have hidden.
            </p>
          ) : (
            <div class="kbh-grid">{articles.map((a) => <KbCard article={a} />)}</div>
          )}
        </>
      ) : (
        categories.map((c) => {
          const mine = byCategory(c.id);
          return (
            <section class="kbh-sec">
              <div class="kbh-sec-h">
                <span class="kb-dot" style={`background:${c.color}`} aria-hidden="true"></span>
                <a class="kbh-sec-t" href={railHref(c.slug)}>{c.title}</a>
                <span class="kb-count">{mine.length}</span>
              </div>
              {mine.length === 0 ? (
                <p class="kbh-empty">Nothing here yet.</p>
              ) : (
                <div class="kbh-grid">{mine.map((a) => <KbCard article={a} />)}</div>
              )}
            </section>
          );
        })
      )}
    </div>
  </div>
</AppLayout>

<style>
  /* The search bar: one control, with the filter funnel living inside it.
     The selects used to sit open under the search box, full width and stacked,
     which pushed the article list off the bottom of the screen on a laptop —
     you had to scroll past the filters to reach what you searched for. */
  .kbf { margin-bottom: 22px; }

  .kbf-bar {
    display: flex; align-items: center; gap: 8px;
    background: var(--s-25); border: 1px solid var(--line);
    border-radius: 13px; padding: 6px 6px 6px 14px; max-width: 720px;
  }
  .kbf-bar:focus-within { border-color: var(--accent-fg); }
  .kbf-icon { color: var(--muted); flex: 0 0 auto; }

  .kbf-bar input {
    flex: 1 1 auto; min-width: 0;
    background: transparent; border: 0; outline: none; padding: 9px 0;
    font: 400 .95rem/1 'Montserrat', system-ui, sans-serif; color: var(--fg);
  }
  .kbf-bar input::placeholder { color: var(--muted); }
  .kbf-go { flex: 0 0 auto; }

  /* ── the filters card ────────────────────────────────────────────────── */
  .kbfc {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px;
    box-shadow: var(--pop-shadow); overflow: hidden;
    position: sticky; top: 96px;
  }
  .kbfc-head {
    display: flex; align-items: center; justify-content: space-between; gap: 10px;
    padding: 14px 10px 14px 16px;
  }
  .kbfc-title {
    font: 800 .76rem/1 'League Spartan', 'Montserrat', sans-serif;
    letter-spacing: .14em; text-transform: uppercase; color: var(--fg);
  }
  .kbfc-collapse {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; margin: -6px; border-radius: 10px;
    background: transparent; border: 0; cursor: pointer; color: var(--info-fg);
  }
  .kbfc-collapse:hover { background: var(--s-2); }

  .kbfc-body { padding: 0 16px 14px; }
  .kbfc-grp { border-top: 1px solid var(--line-soft); }
  .kbfc-grp summary {
    display: flex; align-items: center; justify-content: space-between;
    min-height: 44px; padding: 10px 0; cursor: pointer; list-style: none;
    font: 700 .9rem/1 'Montserrat', system-ui, sans-serif; color: var(--info-fg);
  }
  .kbfc-grp summary::-webkit-details-marker { display: none; }
  .kbfc-grp summary svg { transition: transform .2s ease; opacity: .8; }
  .kbfc-grp[open] summary svg { transform: rotate(180deg); }
  .kbfc-grp select {
    width: 100%; margin: 0 0 12px;
    font: 600 .86rem/1 'Montserrat', system-ui, sans-serif; color: var(--fg);
    background: var(--s-25); border: 1px solid var(--line); border-radius: 9px;
    padding: 10px;
  }
  .kbfc-apply { width: 100%; margin-top: 12px; }
  .kbfc-clear {
    display: block; text-align: center; margin-top: 10px;
    font: 700 .78rem/1 'Montserrat', system-ui, sans-serif;
    color: var(--accent-fg); text-decoration: none;
  }
  .kbfc-clear:hover { text-decoration: underline; }

  /* Collapsed: the card shrinks to a strip with the word turned on its side,
     which is how it stays discoverable rather than disappearing. */
  .kbfc.is-shut { width: 62px; }
  .kbfc.is-shut .kbfc-head { flex-direction: column-reverse; gap: 14px; padding: 12px 8px 18px; }
  .kbfc.is-shut .kbfc-title { writing-mode: vertical-rl; letter-spacing: .18em; }
  .kbfc.is-shut .kbfc-body { display: none; }

  /* ── rail + panel ─────────────────────────────────────────────────────── */
  .kbh { display: grid; grid-template-columns: 224px minmax(0, 1fr); gap: 26px; align-items: start; }
  .kbh:has(.kbfc.is-shut) { grid-template-columns: 62px minmax(0, 1fr); }

  .kbh-rail {
    display: flex; flex-direction: column; gap: 2px; position: sticky; top: 96px;
    /* One row per shelf, and the number of shelves is edited in the admin
       centre. At thirteen the rail is 698px, which does not fit the 624px
       below the sticky offset on a 720px laptop — and a sticky element taller
       than its own room cannot scroll to its bottom, so the last shelves and
       the admin link simply could not be reached. It scrolls instead. */
    max-height: calc(100vh - 112px); overflow-y: auto; overscroll-behavior: contain;
    scrollbar-width: thin;
  }
  .kbh-rail-i {
    display: flex; align-items: center; min-height: 44px; padding: 9px 12px;
    border-left: 3px solid transparent; border-radius: 0 9px 9px 0;
    font: 700 .92rem/1.35 'Montserrat', system-ui, sans-serif;
    color: var(--fg-soft); text-decoration: none;
    transition: color .2s, background .2s, border-color .2s;
  }
  .kbh-rail-i:hover { color: var(--fg); background: var(--s-1); }
  .kbh-rail-i.is-on { color: var(--info-fg); border-left-color: var(--info-fg); background: var(--s-1); }
  .kbh-rail-admin {
    margin-top: 10px; padding: 9px 12px; min-height: 44px; display: flex; align-items: center;
    border-top: 1px solid var(--line);
    font: 700 .82rem/1.35 'Montserrat', system-ui, sans-serif;
    color: var(--accent-fg); text-decoration: none;
  }
  .kbh-rail-admin:hover { text-decoration: underline; }

  .kbh-panel {
    background: var(--s-1); border: 1px solid var(--line); border-radius: 18px;
    padding: 22px; min-height: 280px;
  }
  .kbh-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .kbh-blurb, .kbh-count { margin: 0 0 16px; font-size: .88rem; color: var(--muted); }
  .kbh-empty { margin: 0; font-size: .9rem; color: var(--muted); }

  .kbh-sec { margin-bottom: 26px; }
  .kbh-sec:last-child { margin-bottom: 0; }
  .kbh-sec-h { display: flex; align-items: center; gap: 9px; margin-bottom: 12px; }
  .kbh-sec-t {
    font: 800 1.05rem/1.2 'Montserrat', system-ui, sans-serif;
    color: var(--fg); text-decoration: none;
  }
  .kbh-sec-t:hover { color: var(--info-fg); }

  @media (max-width: 900px) {
    .kbh { grid-template-columns: 1fr; gap: 16px; }
    /* Horizontal above the panel: a vertical rail on a phone is a screen of
       links before any content. */
    .kbh-rail {
      position: static; flex-direction: row; gap: 6px;
      overflow-x: auto; padding-bottom: 4px; scrollbar-width: none;
    }
    .kbh-rail::-webkit-scrollbar { display: none; }
    .kbh-rail-i {
      flex: 0 0 auto; border-left: 0; border-bottom: 3px solid transparent;
      border-radius: 9px 9px 0 0; white-space: nowrap;
    }
    .kbh-rail-i.is-on { border-left: 0; border-bottom-color: var(--info-fg); }
    .kbh-rail-admin { display: none; }
    /* A sideways word in a 62px column is a desktop affordance; on a phone
       the card is just a card. */
    .kbfc { position: static; }
    .kbfc.is-shut { width: auto; }
    .kbfc.is-shut .kbfc-head { flex-direction: row; padding: 14px 10px 14px 16px; }
    .kbfc.is-shut .kbfc-title { writing-mode: horizontal-tb; letter-spacing: .14em; }
    .kbh-panel { padding: 16px; border-radius: 14px; }
  }
  @media (max-width: 640px) {
    .kbh-grid { grid-template-columns: 1fr; }
    .kbf-panel { grid-template-columns: 1fr; }
    .kbf-bar { padding-left: 11px; }
  }
  @media (prefers-reduced-motion: reduce) { .kbh-rail-i { transition: none; } }
</style>

<script is:inline>
  (function () {
    var card = document.querySelector('[data-filters]');
    if (!card) return;

    var toggle = card.querySelector('[data-filters-toggle]');
    var body = card.querySelector('[data-filters-body]');
    var label = toggle.querySelector('.sr-only');

    /* Whether the card is open is a per-person preference, not part of the
       search, so it stays out of the URL. */
    try {
      if (localStorage.getItem('rtc-kb-filters') === 'shut') {
        card.classList.add('is-shut');
        toggle.setAttribute('aria-expanded', 'false');
        label.textContent = 'Show filters';
      }
    } catch (e) {}

    toggle.addEventListener('click', function () {
      var shut = card.classList.toggle('is-shut');
      toggle.setAttribute('aria-expanded', shut ? 'false' : 'true');
      label.textContent = shut ? 'Show filters' : 'Hide filters';
      body.hidden = false;
      try { localStorage.setItem('rtc-kb-filters', shut ? 'shut' : 'open'); } catch (e) {}
    });

    /* Changing a filter searches straight away. The Apply button stays in the
       markup for the no-JavaScript case, so it is only hidden once this runs. */
    var apply = card.querySelector('.kbfc-apply');
    if (apply) apply.style.display = 'none';
    card.querySelectorAll('[data-kbf-select]').forEach(function (sel) {
      sel.addEventListener('change', function () { sel.form.submit(); });
    });
  })();
</script>
