---
import AppLayout from '../layouts/AppLayout.astro';
import Avatar from '../components/Avatar.astro';
import { createSupabaseServer } from '../lib/supabase';
import { STATUS_LABEL } from '../lib/queries';

const user = Astro.locals.user!;
const supabase = createSupabaseServer(Astro);
const { data } = await supabase
  .from('profiles')
  .select('full_name, avatar_url, email_opt_out, role')
  .eq('id', user.id)
  .single();
const me = (data as { full_name: string | null; avatar_url: string | null; email_opt_out: boolean | null; role: string } | null);

const ROLE_LABEL: Record<string, string> = {
  super_admin: 'Super admin', admin: 'Admin', staff: 'Staff',
};
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
const wantsEmail = !me?.email_opt_out;
---

<AppLayout title="My account · Robles Tech PPM">
  <p class="eyebrow">Account</p>
  <h1>My account</h1>
  <p class="lede">Your profile, your password, and what PPM is allowed to email you about.</p>

  {ok && <div class="alert alert-ok">{ok}</div>}
  {err && <div class="alert alert-error">{err}</div>}

  <div class="acct-grid">
    <!-- Profile ------------------------------------------------------------ -->
    <div class="card">
      <h2 class="acct-h">Profile</h2>
      <p class="hint" style="margin:0 0 16px;">
        Signed in as <b style="color:#cdd8f0;">{user.email}</b>
        {me?.role && <> · {ROLE_LABEL[me.role] ?? me.role}</>}
      </p>

      <form method="post" action="/api/profile-update" enctype="multipart/form-data" id="profile-form">
        <div class="avatar-row">
          <span id="avatar-preview-wrap">
            <Avatar id={user.id} name={me?.full_name} email={user.email} path={me?.avatar_url} size={72} />
          </span>
          <div style="flex:1;min-width:180px;">
            <label for="avatar">Profile picture</label>
            <input id="avatar" type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" />
            <p class="hint" style="margin-top:6px;">
              JPEG, PNG, WebP or GIF up to 2 MB. A square image looks best.
              {me?.avatar_url && (
                <>
                  {' · '}
                  {/* Its own form: a submit button inside the profile form would
                      become that form's Enter-key default. */}
                  <button type="submit" class="linkbtn" form="remove-avatar">Remove photo</button>
                </>
              )}
            </p>
          </div>
        </div>

        <div style="margin-top:16px;max-width:340px;">
          <label for="full_name">Display name</label>
          <input id="full_name" name="full_name" value={me?.full_name ?? ''} placeholder="How your name appears on tasks" />
        </div>

        <button class="btn" type="submit" style="margin-top:16px;">Save profile</button>
      </form>
      {me?.avatar_url && (
        <form id="remove-avatar" method="post" action="/api/profile-update" hidden>
          <input type="hidden" name="remove" value="1" />
        </form>
      )}
    </div>

    <!-- Email preferences -------------------------------------------------- -->
    <div class="card">
      <h2 class="acct-h">Task emails</h2>
      <p class="hint" style="margin:0 0 14px;">
        PPM emails you when a task is assigned to you, when a task you created moves
        ({STATUS_LABEL.done.toLowerCase()}, {STATUS_LABEL.cancelled.toLowerCase()}, and so on),
        and the morning a task of yours is due. Turn that off here.
      </p>
      <form method="post" action="/api/notify-prefs">
        <label class="checkrow">
          <input type="checkbox" name="emails" value="1" checked={wantsEmail} />
          <span>Email me about my tasks</span>
        </label>
        <p class="hint" style="margin:10px 0 0;">
          {wantsEmail
            ? 'Currently on.'
            : "Currently off — you won't get task emails. Everything still shows up in the app."}
        </p>
        <button class="btn" type="submit" style="margin-top:16px;">Save preference</button>
      </form>
    </div>

    <!-- Password ----------------------------------------------------------- -->
    <div class="card">
      <h2 class="acct-h">Password</h2>
      <p class="hint" style="margin:0 0 14px;">At least 8 characters. You'll stay signed in on this device.</p>
      <form method="post" action="/api/change-password" style="max-width:340px;">
        <div>
          <label for="pw">New password</label>
          <input id="pw" name="password" type="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" />
        </div>
        <div style="margin-top:12px;">
          <label for="pw2">Confirm new password</label>
          <input id="pw2" name="confirm" type="password" autocomplete="new-password" required minlength="8" placeholder="Repeat it" />
        </div>
        <button class="btn" type="submit" style="margin-top:16px;">Update password</button>
      </form>
    </div>
  </div>

  <script is:inline>
    // Preview the chosen photo before saving. A data: URL, not blob:, because the
    // Content-Security-Policy allows img-src 'self' and data: only.
    (function () {
      var input = document.getElementById('avatar');
      var wrap = document.getElementById('avatar-preview-wrap');
      if (!input || !wrap) return;
      input.addEventListener('change', function () {
        var file = input.files && input.files[0];
        if (!file || !/^image\//.test(file.type)) return;
        var reader = new FileReader();
        reader.onload = function () {
          wrap.innerHTML = '';
          var img = document.createElement('img');
          img.className = 'avatar';
          img.alt = '';
          img.style.width = '72px';
          img.style.height = '72px';
          img.src = String(reader.result);
          wrap.appendChild(img);
        };
        reader.readAsDataURL(file);
      });
    })();
  </script>
</AppLayout>
