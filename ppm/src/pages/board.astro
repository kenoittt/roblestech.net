---
import AppLayout from '../layouts/AppLayout.astro';
import { loadPpmData, nameOf, STATUSES } from '../lib/queries';

const { tasks, people, projects, fAssignee, fProject } = await loadPpmData(Astro);
const back = Astro.url.pathname + Astro.url.search;

const cols = STATUSES;
const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');
---

<AppLayout title="Board · Robles Tech PPM">
  <p class="eyebrow">Project Management</p>
  <h1>Board</h1>
  <p class="lede">Drag-free kanban: change status or assignee right on the card.</p>

  {ok && <div class="alert alert-ok">{ok}</div>}
  {err && <div class="alert alert-error">{err}</div>}

  <!-- New task -->
  <div class="card">
    <form method="post" action="/api/task-create" class="row" id="new-task">
      <input type="hidden" name="back" value={back} />
      <div><label>New task</label><input name="title" required placeholder="What needs doing?" /></div>
      <div><label>Assignee</label>
        <select name="assignee_id">
          <option value="">Unassigned</option>
          {people.map((p) => <option value={p.id}>{p.full_name || p.id.slice(0, 8)}</option>)}
        </select>
      </div>
      <div><label>Priority</label>
        <select name="priority"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select>
      </div>
      <div><label>Due</label><input type="date" name="due_date" /></div>
    </form>
    <div style="margin-top:12px;display:flex;gap:12px;align-items:end;flex-wrap:wrap;">
      <div style="min-width:200px;">
        <label>Project (optional)</label>
        <select name="project_id" form="new-task">
          <option value="">No project</option>
          {projects.map((p) => <option value={p.id}>{p.name}</option>)}
        </select>
      </div>
      <button class="btn" form="new-task" type="submit">Add task</button>
    </div>
  </div>

  <!-- Filters -->
  <form method="get" class="filterbar">
    <label>Assignee
      <select name="assignee" class="js-filter">
        <option value="">Everyone</option>
        <option value="none" selected={fAssignee === 'none'}>Unassigned</option>
        {people.map((p) => <option value={p.id} selected={fAssignee === p.id}>{p.full_name || p.id.slice(0, 8)}</option>)}
      </select>
    </label>
    <label>Project
      <select name="project" class="js-filter">
        <option value="">All projects</option>
        {projects.map((p) => <option value={p.id} selected={fProject === p.id}>{p.name}</option>)}
      </select>
    </label>
    {(fAssignee || fProject) && <a href="/board" class="mini-link">Clear filters</a>}
  </form>

  <div class="board" style="margin-top:14px;">
    {cols.map((c) => (
      <div class={`col col-${c.key}`}>
        <h3>{c.label}<span>{tasks.filter((t) => t.status === c.key).length}</span></h3>
        {tasks.filter((t) => t.status === c.key).map((t) => (
          <div class={`task task-${t.status}`}>
            <div class="t-row">
              <div class="t">{t.title}</div>
              <form method="post" action="/api/task-delete" class="delform js-confirm" data-confirm={`Delete "${t.title}"? This cannot be undone.`}>
                <input type="hidden" name="id" value={t.id} />
                <input type="hidden" name="back" value={back} />
                <button type="submit" class="del-btn" title="Delete task" aria-label={`Delete task: ${t.title}`}>
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M10 4h4l.5 3h-5L10 4Z"/><path d="M6.5 7l1 12.5A1.5 1.5 0 0 0 9 21h6a1.5 1.5 0 0 0 1.5-1.5L17.5 7"/><path d="M10 11v6M14 11v6"/></svg>
                </button>
              </form>
            </div>
            <div class="m">
              <span class={`pill ${t.priority}`}>{t.priority}</span>
              <span>{nameOf(people, t.assignee_id)}</span>
              {t.due_date && <span>· due {t.due_date}</span>}
            </div>
            <form method="post" action="/api/task-update" class="statusform">
              <input type="hidden" name="id" value={t.id} />
              <input type="hidden" name="back" value={back} />
              <select name="status" class="js-auto" aria-label={`Status of ${t.title}`}>
                {STATUSES.map((s) => <option value={s.key} selected={t.status === s.key}>{s.label}</option>)}
              </select>
              <select name="assignee_id" class="js-auto" aria-label={`Assignee of ${t.title}`}>
                <option value="">Unassigned</option>
                {people.map((p) => <option value={p.id} selected={t.assignee_id === p.id}>{p.full_name || p.id.slice(0, 8)}</option>)}
              </select>
            </form>
          </div>
        ))}
        {tasks.filter((t) => t.status === c.key).length === 0 && (
          <p class="col-empty">Nothing here.</p>
        )}
      </div>
    ))}
  </div>

  <script is:inline>
    document.querySelectorAll('.js-auto').forEach((el) => el.addEventListener('change', (e) => e.target.closest('form').submit()));
    document.querySelectorAll('.js-filter').forEach((el) => el.addEventListener('change', (e) => e.target.closest('form').submit()));
    // Deletes are permanent — always ask first.
    document.querySelectorAll('form.js-confirm').forEach((f) =>
      f.addEventListener('submit', (e) => {
        if (!window.confirm(f.dataset.confirm || 'Delete this task? This cannot be undone.')) e.preventDefault();
      })
    );
  </script>
</AppLayout>
