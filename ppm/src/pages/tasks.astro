---
import AppLayout from '../layouts/AppLayout.astro';
import { loadPpmData, STATUSES } from '../lib/queries';

const { tasks, people, projects, fAssignee, fProject, fStatus } = await loadPpmData(Astro);
const back = Astro.url.pathname + Astro.url.search;

const ok = Astro.url.searchParams.get('ok');
const err = Astro.url.searchParams.get('err');

// Sheet columns. `w` is the default width in px; users drag from here and the
// result is kept per-browser in localStorage (see the script at the bottom).
const COLS = [
  { key: 'title', label: 'Task', w: 300 },
  { key: 'project', label: 'Project', w: 150 },
  { key: 'assignee', label: 'Assignee', w: 165 },
  { key: 'priority', label: 'Priority', w: 120 },
  { key: 'status', label: 'Status', w: 140 },
  { key: 'due', label: 'Due', w: 160 },
  { key: 'actions', label: '', w: 70 },
];
---

<AppLayout title="Tasks · Robles Tech PPM">
  <p class="eyebrow">Project Management</p>
  <h1>Tasks</h1>
  <p class="lede">Sheet view — click any cell, change it, and it saves instantly.</p>

  {ok && <div class="alert alert-ok">{ok}</div>}
  {err && <div class="alert alert-error">{err}</div>}

  <!-- Filters -->
  <form method="get" class="filterbar">
    <label>Assignee
      <select name="assignee" class="js-filter">
        <option value="">Everyone</option>
        <option value="none" selected={fAssignee === 'none'}>Unassigned</option>
        {people.map((p) => <option value={p.id} selected={fAssignee === p.id}>{p.full_name || p.id.slice(0, 8)}</option>)}
      </select>
    </label>
    <label>Project
      <select name="project" class="js-filter">
        <option value="">All projects</option>
        {projects.map((p) => <option value={p.id} selected={fProject === p.id}>{p.name}</option>)}
      </select>
    </label>
    <label>Status
      <select name="status" class="js-filter">
        <option value="">All</option>
        {STATUSES.map((s) => <option value={s.key} selected={fStatus === s.key}>{s.label}</option>)}
      </select>
    </label>
    {(fAssignee || fProject || fStatus) && <a href="/tasks" class="mini-link">Clear filters</a>}
  </form>

  <div class="sheetbar">
    <span class="hint" style="margin:0;">Drag a column edge to resize it — widths are remembered on this device.</span>
    <button type="button" class="linkbtn" id="reset-cols">Reset column widths</button>
  </div>

  <div class="ttable-wrap">
    <table class="ttable ttable-resize" id="task-sheet">
      <colgroup>
        {COLS.map((c) => <col data-col={c.key} style={`width:${c.w}px;`} />)}
      </colgroup>
      <thead>
        <tr>
          {COLS.map((c, i) => (
            <th>
              {c.label ? c.label : <span class="sr-only">Delete</span>}
              {i < COLS.length - 1 && (
                <span class="col-resizer" data-i={i} role="separator" aria-orientation="vertical"
                      tabindex="0" aria-label={`Resize ${c.label || 'last'} column`} title="Drag to resize (or use ← →)"></span>
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {tasks.map((t) => {
          const fid = `f-${t.id}`;
          return (
            <tr class={t.status === 'done' ? 'is-done' : t.status === 'cancelled' ? 'is-cancelled' : ''}>
              <td class="c-title"><input form={fid} name="title" value={t.title} class="cell-input js-auto" /></td>
              <td>
                <select form={fid} name="project_id" class="cell-select js-auto">
                  <option value="">—</option>
                  {projects.map((p) => <option value={p.id} selected={t.project_id === p.id}>{p.name}</option>)}
                </select>
              </td>
              <td>
                <select form={fid} name="assignee_id" class="cell-select js-auto">
                  <option value="">Unassigned</option>
                  {people.map((p) => <option value={p.id} selected={t.assignee_id === p.id}>{p.full_name || p.id.slice(0, 8)}</option>)}
                </select>
              </td>
              <td>
                <select form={fid} name="priority" class={`cell-select js-auto pr-${t.priority}`}>
                  <option value="low" selected={t.priority === 'low'}>Low</option>
                  <option value="medium" selected={t.priority === 'medium'}>Medium</option>
                  <option value="high" selected={t.priority === 'high'}>High</option>
                </select>
              </td>
              <td>
                <select form={fid} name="status" class={`cell-select js-auto st-${t.status}`}>
                  {STATUSES.map((s) => <option value={s.key} selected={t.status === s.key}>{s.label}</option>)}
                </select>
              </td>
              <td><input form={fid} type="date" name="due_date" value={t.due_date ?? ''} class="cell-input js-auto" /></td>
              <td style="text-align:right;">
                <button form={`d-${t.id}`} type="submit" class="del-btn" title="Delete task" aria-label={`Delete task: ${t.title}`}>
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M10 4h4l.5 3h-5L10 4Z"/><path d="M6.5 7l1 12.5A1.5 1.5 0 0 0 9 21h6a1.5 1.5 0 0 0 1.5-1.5L17.5 7"/><path d="M10 11v6M14 11v6"/></svg>
                </button>
              </td>
            </tr>
          );
        })}
        {tasks.length === 0 && <tr><td colspan="7" class="muted" style="text-align:center;padding:26px;">No tasks match these filters.</td></tr>}
        <!-- Add row -->
        <tr class="addrow">
          <td><input form="f-new" name="title" required placeholder="+ New task…" class="cell-input" /></td>
          <td>
            <select form="f-new" name="project_id" class="cell-select"><option value="">—</option>{projects.map((p) => <option value={p.id}>{p.name}</option>)}</select>
          </td>
          <td>
            <select form="f-new" name="assignee_id" class="cell-select"><option value="">Unassigned</option>{people.map((p) => <option value={p.id}>{p.full_name || p.id.slice(0, 8)}</option>)}</select>
          </td>
          <td>
            <select form="f-new" name="priority" class="cell-select"><option value="medium">Medium</option><option value="high">High</option><option value="low">Low</option></select>
          </td>
          <td class="muted" style="font-size:.8rem;">To do</td>
          <td><input form="f-new" type="date" name="due_date" class="cell-input" /></td>
          <td style="text-align:right;">
            <button form="f-new" type="submit" class="btn" style="padding:6px 10px;font-size:.75rem;">Add</button>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Row forms (form attribute keeps table HTML valid) -->
  {tasks.map((t) => (
    <>
      <form id={`f-${t.id}`} method="post" action="/api/task-update" hidden>
        <input type="hidden" name="id" value={t.id} />
        <input type="hidden" name="back" value={back} />
      </form>
      <form id={`d-${t.id}`} method="post" action="/api/task-delete" class="js-confirm" data-confirm={`Delete "${t.title}"? This cannot be undone.`} hidden>
        <input type="hidden" name="id" value={t.id} />
        <input type="hidden" name="back" value={back} />
      </form>
    </>
  ))}
  <form id="f-new" method="post" action="/api/task-create" hidden>
    <input type="hidden" name="back" value={back} />
  </form>

  <!-- Bulk import -->
  <details class="card" style="margin-top:18px;">
    <summary style="cursor:pointer;font-weight:700;">Bulk import tasks (CSV)</summary>
    <p class="hint" style="margin:12px 0;">
      Download the template, fill it in, and upload. Columns: <code>title, description, assignee_email, priority, due_date, project</code>.
    </p>
    <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
      <a class="btn" href="/api/task-template.csv" style="background:rgba(255,255,255,0.1);color:#fff;">↓ Download template</a>
      <form method="post" action="/api/task-import" enctype="multipart/form-data" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
        <input type="file" name="file" accept=".csv,text/csv" required />
        <button class="btn" type="submit">Upload CSV</button>
      </form>
    </div>
  </details>

  <script is:inline>
    // Sheet behavior: any change saves that row immediately (selects on change,
    // text/date inputs on change = blur or Enter).
    document.querySelectorAll('.js-auto').forEach((el) =>
      el.addEventListener('change', () => { if (el.form) el.form.submit(); })
    );
    document.querySelectorAll('.js-filter').forEach((el) =>
      el.addEventListener('change', (e) => e.target.closest('form').submit())
    );
    // Deletes are permanent — always ask first.
    document.querySelectorAll('form.js-confirm').forEach((f) =>
      f.addEventListener('submit', (e) => {
        if (!window.confirm(f.dataset.confirm || 'Delete this task? This cannot be undone.')) e.preventDefault();
      })
    );

    // ── Resizable columns ────────────────────────────────────────────────
    // Drag a header edge (or focus it and press ← / →). Widths live in
    // localStorage per browser, so the sheet stays how you left it.
    (function () {
      var KEY = 'ppm.tasks.colWidths.v1';
      var MIN = 56;
      var table = document.getElementById('task-sheet');
      if (!table) return;
      var cols = Array.prototype.slice.call(table.querySelectorAll('colgroup col'));
      var defaults = cols.map(function (c) { return parseInt(c.style.width, 10) || 120; });

      function widths() {
        return cols.map(function (c, i) { return parseInt(c.style.width, 10) || defaults[i]; });
      }
      function apply(list) {
        list.forEach(function (w, i) { if (cols[i]) cols[i].style.width = Math.max(MIN, w) + 'px'; });
        table.style.width = list.reduce(function (a, b) { return a + Math.max(MIN, b); }, 0) + 'px';
      }
      function save() {
        try { localStorage.setItem(KEY, JSON.stringify(widths())); } catch (e) { /* private mode */ }
      }

      // Defaults grow the Task column so the sheet fills its card; saved widths
      // are used exactly as the user left them.
      function applyDefaults() {
        var list = defaults.slice();
        var wrap = table.parentElement;
        var slack = (wrap ? wrap.clientWidth : 0) - list.reduce(function (a, b) { return a + b; }, 0);
        if (slack > 0) list[0] += slack;
        apply(list);
      }

      // Restore, ignoring a stale entry from a different column count.
      try {
        var saved = JSON.parse(localStorage.getItem(KEY) || 'null');
        if (Array.isArray(saved) && saved.length === cols.length) apply(saved);
        else applyDefaults();
      } catch (e) { applyDefaults(); }

      table.querySelectorAll('.col-resizer').forEach(function (h) {
        var i = parseInt(h.dataset.i, 10);
        h.addEventListener('pointerdown', function (ev) {
          ev.preventDefault();
          var startX = ev.clientX;
          var start = widths()[i];
          h.setPointerCapture(ev.pointerId);
          h.classList.add('is-dragging');
          function move(e) {
            var next = widths();
            next[i] = Math.max(MIN, start + (e.clientX - startX));
            apply(next);
          }
          function up() {
            h.classList.remove('is-dragging');
            h.removeEventListener('pointermove', move);
            h.removeEventListener('pointerup', up);
            h.removeEventListener('pointercancel', up);
            save();
          }
          h.addEventListener('pointermove', move);
          h.addEventListener('pointerup', up);
          h.addEventListener('pointercancel', up);
        });
        // Keyboard: same resize without a mouse.
        h.addEventListener('keydown', function (e) {
          var step = e.key === 'ArrowLeft' ? -16 : e.key === 'ArrowRight' ? 16 : 0;
          if (!step) return;
          e.preventDefault();
          var next = widths();
          next[i] = Math.max(MIN, next[i] + step);
          apply(next);
          save();
        });
      });

      var reset = document.getElementById('reset-cols');
      if (reset) reset.addEventListener('click', function () {
        applyDefaults();
        try { localStorage.removeItem(KEY); } catch (e) { /* private mode */ }
      });
    })();
  </script>
</AppLayout>
